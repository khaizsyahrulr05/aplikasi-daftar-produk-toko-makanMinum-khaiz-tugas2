<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="toko.controller.FormController"
            stylesheets="@styles/app.css">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label text="Produk Toko" styleClass="title"/>
            <Button text="Lihat Daftar" onAction="#bukaDaftar"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label text="Tambah produk baru" styleClass="subtitle"/>
                        <Label text="Nama produk"/>
                        <TextField fx:id="namaField" promptText="Contoh: Kopi golda"/>
                        <Label text="Kategori"/>
                        <ComboBox fx:id="kategoriBox" maxWidth="Infinity"/>
                        <Label text="Harga (Rp)"/>
                        <TextField fx:id="hargaField" promptText="Contoh: 5000"/>
                        <Label text="Gambar (opsional)"/>
                        <ImageView fx:id="gambarView" fitWidth="160" fitHeight="160" preserveRatio="true"/>
                        <HBox spacing="10">
                            <Button text="Pilih Gambar" onAction="#pilihGambar"/>
                            <Button text="Hapus Gambar" onAction="#hapusGambar"/>
                        </HBox>
                        <Button text="Simpan" onAction="#simpan"
                                styleClass="button-primary" maxWidth="Infinity"/>
                        <Label fx:id="pesanLabel" wrapText="true"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>